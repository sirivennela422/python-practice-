import random
print("---number guessing game---")
print("guess the number from 1 to 50")
secert_number=random.randint(1,50)
while True:
    guess=int(input("enter your guess number"))
    if(guess<secert_number):
        print("too low !try again")
    elif(guess>secert_number):
        print("too high! try again")
    else:
        print("yes you guessed corret number")
        break
print("computer number",secert_number)

